# VirtualRodent — project environment variables
#
# Copy this file to `.env` and fill in values for your local machine.
# `.env` is gitignored so machine-specific paths and secrets stay out of git.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Data paths
# ---------------------------------------------------------------------------

# Absolute path to the Virtual Rodent dataset root (contains DLS/ and
# motor_cortex/ subdirectories of per-session HDF5 files). On a workstation
# this often lives on an external drive, e.g.
# /Volumes/mydrive/data/animal_behavior/Virtual_Rodent
VIRTUAL_RODENT_DATA_DIR=data/Virtual_Rodent

# Where training results / predictions are written and read from.
VIRTUAL_RODENT_RESULTS_DIR=outs/results

# Where rendered plots, videos, and neural visualizations are written.
VIRTUAL_RODENT_VIZ_DIR=outs/visualizations

# ---------------------------------------------------------------------------
# Website backend (Flask API — src/website/app.py)
# ---------------------------------------------------------------------------

# Host/port the Flask API binds to. The Vite dev server proxies /api here.
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Set to 1 to run the Flask API in debug mode.
FLASK_DEBUG=1

# ---------------------------------------------------------------------------
# Website frontend (Vite dev server — src/website/frontend)
# ---------------------------------------------------------------------------

# Port the Vite dev server listens on.
FRONTEND_PORT=3000
